{
  "openapi": "3.1.0",
  "info": {
    "title": "SimuEmploi API candidat",
    "description": "Première tranche locale : catalogue d'exemples à relire. Aucun compte ou entraînement privé.",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "operations"
        ],
        "summary": "Health",
        "operationId": "health_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Scenarios",
        "operationId": "CAT_01_list_scenarios",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Domain"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Domain"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/api/v1/scenarios/{scenario_id}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Read Scenario",
        "operationId": "CAT_02_read_scenario",
        "parameters": [
          {
            "name": "scenario_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Scenario Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioDetail"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ScenarioSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "content_status": {
            "type": "string",
            "const": "example_pending_review",
            "title": "Content Status",
            "default": "example_pending_review"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "CatalogPage"
      },
      "Criterion": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Key"
          },
          "label": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Label"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "label",
          "description"
        ],
        "title": "Criterion"
      },
      "Domain": {
        "type": "string",
        "enum": [
          "beginner",
          "presentation"
        ],
        "title": "Domain"
      },
      "ErrorResponse": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "correlation_id": {
            "type": "string",
            "title": "Correlation Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "Question": {
        "properties": {
          "key": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Key"
          },
          "prompt": {
            "type": "string",
            "maxLength": 700,
            "minLength": 1,
            "title": "Prompt"
          },
          "guidance": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Guidance"
          },
          "criteria": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 1,
            "title": "Criteria"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "prompt",
          "guidance",
          "criteria"
        ],
        "title": "Question"
      },
      "ScenarioDetail": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Slug"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Summary"
          },
          "objective": {
            "type": "string",
            "enum": [
              "internship",
              "first_job"
            ],
            "title": "Objective"
          },
          "domain": {
            "$ref": "#/components/schemas/Domain"
          },
          "estimated_minutes": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Estimated Minutes"
          },
          "country": {
            "type": "string",
            "const": "BF",
            "title": "Country",
            "default": "BF"
          },
          "locale": {
            "type": "string",
            "const": "fr",
            "title": "Locale",
            "default": "fr"
          },
          "modality": {
            "type": "string",
            "const": "text",
            "title": "Modality",
            "default": "text"
          },
          "question_count": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Question Count"
          },
          "content_status": {
            "type": "string",
            "const": "example_pending_review",
            "title": "Content Status",
            "default": "example_pending_review"
          },
          "preparation": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Preparation"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Questions"
          },
          "rubric": {
            "items": {
              "$ref": "#/components/schemas/Criterion"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Rubric"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "slug",
          "version",
          "title",
          "summary",
          "objective",
          "domain",
          "estimated_minutes",
          "question_count",
          "preparation",
          "questions",
          "rubric"
        ],
        "title": "ScenarioDetail"
      },
      "ScenarioSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Slug"
          },
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "title": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "title": "Title"
          },
          "summary": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Summary"
          },
          "objective": {
            "type": "string",
            "enum": [
              "internship",
              "first_job"
            ],
            "title": "Objective"
          },
          "domain": {
            "$ref": "#/components/schemas/Domain"
          },
          "estimated_minutes": {
            "type": "integer",
            "maximum": 60.0,
            "minimum": 1.0,
            "title": "Estimated Minutes"
          },
          "country": {
            "type": "string",
            "const": "BF",
            "title": "Country",
            "default": "BF"
          },
          "locale": {
            "type": "string",
            "const": "fr",
            "title": "Locale",
            "default": "fr"
          },
          "modality": {
            "type": "string",
            "const": "text",
            "title": "Modality",
            "default": "text"
          },
          "question_count": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Question Count"
          },
          "content_status": {
            "type": "string",
            "const": "example_pending_review",
            "title": "Content Status",
            "default": "example_pending_review"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "slug",
          "version",
          "title",
          "summary",
          "objective",
          "domain",
          "estimated_minutes",
          "question_count"
        ],
        "title": "ScenarioSummary"
      }
    }
  }
}
